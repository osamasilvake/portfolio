generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ProfileContent {
  id                String @id @default(cuid())
  locale            String @unique @default("en")
  intro             String
  specialties       String
  passion           String
  buttonTitle       String
  yearsExperience   String
  satisfactionRate  String
  satisfactionLabel String
}

model ServiceItem {
  id          String @id @default(cuid())
  key         String
  title       String
  description String
  iconName    String
  size        String
  order       Int    @default(0)
  locale      String @default("en")

  @@unique([key, locale])
}

model Skill {
  id   String @id @default(cuid())
  name String
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}
